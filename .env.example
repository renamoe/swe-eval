# Must include /v1. Credentials belong only here / process environment.
EVAL_API_BASE=http://localhost:8000/v1
EVAL_API_KEY=EMPTY
EVAL_MODEL=qwen35-9b
EVAL_CHECKPOINT=baseline
# Deployment metadata supplied by server operator, never inferred from alias.
VLLM_MODEL_PATH=/models/Qwen3.5-9B
VLLM_VERSION=
VLLM_CHAT_TEMPLATE_FILE=
EVAL_CONTEXT_LENGTH=131072
EVAL_MAX_TOKENS=16384
EVAL_MAX_TURNS=100
EVAL_SWE_AGENT_TIMEOUT=3600
EVAL_SWE_SCORE_TIMEOUT=1800
EVAL_API_TIMEOUT=180
EVAL_TEMPERATURE=0.6
EVAL_TOP_P=0.95
EVAL_TOP_K=20
EVAL_PRESENCE_PENALTY=0
# Optional immutable Hugging Face revision; prepare resolves main to a commit.
EVAL_SWE_REVISION=main
# Alternatively use a local model instance (see .env.openai-compatible.example).
# EVAL_MODEL_INSTANCE=models/example.local.json
# EVAL_API_BACKEND=openai-compatible
# EVAL_THINKING=false
# EVAL_API_KEY_ENV=MODEL_API_KEY
