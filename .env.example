# Credentials and tool environment only. Evaluation settings live in configs/ and
# are overridden explicitly with --set; EVAL_* and VLLM_* entries are ignored.
# Each model config names its key variable via api_key_env.
MODEL_API_KEY=
# HF_TOKEN=
# Optional immutable Hugging Face revision; prepare resolves main to a commit.
EVAL_SWE_REVISION=main
